# ============================================================
# PathFinder AI — 환경변수 설정 예시
# 이 파일을 복사해 .env 파일을 만들고 실제 키를 입력하세요.
# cp .env.example .env
# ============================================================

# ── AI 분석 API (하나 이상 필수) ────────────────────────────
# Anthropic Claude API 키
# 발급: https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=sk-ant-여기에_입력

# OpenAI API 키 (Whisper 음성 전사 + GPT-4o 분석 대안)
# 발급: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-여기에_입력

# ── 분석 모델 선택 (기본값: claude) ─────────────────────────
# "claude" 또는 "openai"
VITE_AI_PROVIDER=claude

# Claude 모델명 (기본값 권장)
VITE_CLAUDE_MODEL=claude-haiku-4-5-20251001

# OpenAI 모델명 (기본값 권장)
VITE_OPENAI_MODEL=gpt-4o

# ── 개발 환경 설정 ───────────────────────────────────────────
# "true"로 설정하면 실제 API 호출 없이 Mock 데이터로 동작
VITE_USE_MOCK=false

# ⚠️  주의사항
# - VITE_ 접두사가 붙은 변수만 브라우저에서 접근 가능합니다.
# - 이 파일(.env)은 절대 Git에 커밋하지 마세요.
# - .env.example만 커밋하고 팀원과 공유하세요.
# - 프로덕션에서는 백엔드 프록시를 통해 API를 호출해야 합니다.
